---
import { ICONS } from '../../lib/icons';
import { t } from '../../i18n';

interface Props {
  ruler?: boolean;
  current?: 'map' | 'notations' | 'glossary';
}
const { ruler = false, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { key: 'map', href: `${base}carte/`, label: t('nav.map') },
  { key: 'notations', href: `${base}notations/`, label: t('nav.notations') },
  { key: 'glossary', href: `${base}glossaire/`, label: t('nav.glossary') },
] as const;
---

<header class="site-header">
  <div class="bar">
    <a class="wordmark" href={base}>
      <Fragment set:html={ICONS.mark} />
      <span class="wm-text">{t('site.title')}</span>
    </a>
    <nav aria-label={t('nav.main')}>
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
    <button class="icon-btn" type="button" data-theme-toggle aria-label={t('theme.toggle')}>
      <Fragment set:html={ICONS.theme} />
    </button>
  </div>
  {ruler ? (
    <div
      class="ruler"
      data-ruler
      role="progressbar"
      aria-label={t('ruler.label')}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="fill" />
    </div>
  ) : (
    <div class="ruler" aria-hidden="true" />
  )}
</header>

<script>
  // Theme toggle: explicit choice is stored; otherwise follow the system.
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    b.addEventListener('click', () => {
      const root = document.documentElement;
      const current =
        root.dataset.theme ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable: the choice lasts for this page only */
      }
      window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
    });
  }

  // Reading ruler: fill = scroll progress through <main>, ticks = h2 sections.
  const ruler = document.querySelector<HTMLElement>('[data-ruler]');
  const main = document.querySelector<HTMLElement>('main');
  if (ruler && main) {
    const fill = ruler.querySelector<HTMLElement>('.fill')!;
    const ticks: { el: HTMLElement; at: number }[] = [];
    const layout = () => {
      for (const t of ticks) t.el.remove();
      ticks.length = 0;
      const top = main.offsetTop;
      const span = Math.max(1, main.offsetHeight - innerHeight);
      for (const h of main.querySelectorAll<HTMLElement>('h2')) {
        const at = Math.min(1, Math.max(0, (h.getBoundingClientRect().top + scrollY - top) / span));
        const el = document.createElement('span');
        el.className = 'tick';
        el.style.left = `${at * 100}%`;
        ruler.appendChild(el);
        ticks.push({ el, at });
      }
      update();
    };
    const update = () => {
      const span = Math.max(1, main.offsetHeight - innerHeight);
      const p = Math.min(1, Math.max(0, (scrollY - main.offsetTop) / span));
      fill.style.transform = `scaleX(${p})`;
      ruler.setAttribute('aria-valuenow', String(Math.round(p * 100)));
      for (const t of ticks) t.el.classList.toggle('passed', t.at <= p);
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', layout);
    addEventListener('load', layout);
    layout();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-bg);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
    padding: 0 var(--space-3) 0 var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-ui);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    font-weight: 700;
    text-decoration: none;
    min-height: var(--touch);
  }
  nav {
    display: flex;
    gap: var(--space-5);
  }
  nav a {
    color: var(--color-ink-muted);
    text-decoration: none;
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--color-ink);
  }
  .icon-btn {
    width: var(--touch);
    height: var(--touch);
    display: inline-grid;
    place-items: center;
    border: 0;
    background: none;
    border-radius: var(--radius);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--color-surface);
  }
  .ruler {
    position: relative;
    height: 9px;
    border-top: var(--rule-w) solid var(--color-rule);
    overflow: hidden;
  }
  .ruler .fill {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 2px;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  .ruler :global(.tick) {
    position: absolute;
    top: 0;
    width: 1px;
    height: 8px;
    background: var(--color-rule);
  }
  .ruler :global(.tick.passed) {
    background: var(--color-ink);
  }
  @media (max-width: 760px) {
    .bar {
      padding: 0 var(--space-1) 0 var(--gutter);
      gap: var(--space-2);
    }
    nav {
      gap: var(--space-4);
      font-size: var(--text-small);
    }
    .wm-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
