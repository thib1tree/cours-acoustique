---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import 'katex/dist/katex.min.css';
import '../styles/base.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { t } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** Hide the site header (home page draws its own). */
  bare?: boolean;
  /** Show the reading-progress ruler with section ticks. */
  ruler?: boolean;
  current?: 'map' | 'notations' | 'glossary';
}

const {
  title,
  description = t('site.description'),
  bare = false,
  ruler = false,
  current,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === t('site.title') ? title : `${title} | ${t('site.title')}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <meta name="theme-color" content="#F6F7F9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B111E" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {
        /* storage unavailable: follow the system theme */
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {t('a11y.skip')}
    </a>
    {!bare && <SiteHeader ruler={ruler} {...(current ? { current } : {})} />}
    <slot />
    <script>
      // Equations wider than the screen scroll horizontally inside their box: make
      // only those focusable so keyboard users can scroll them (WCAG 2.1.1).
      const markScrollable = () => {
        for (const el of document.querySelectorAll<HTMLElement>(
          '.katex-display, figure.eq .display, .prose table',
        )) {
          const scrollable = el.scrollWidth > el.clientWidth + 1;
          if (scrollable && !el.dataset.scrollable) {
            el.dataset.scrollable = '1';
            el.tabIndex = 0;
            el.setAttribute('role', 'group');
            el.setAttribute(
              'aria-label',
              el.tagName === 'TABLE'
                ? 'Tableau (défilement horizontal)'
                : 'Équation (défilement horizontal)',
            );
          } else if (!scrollable && el.dataset.scrollable) {
            delete el.dataset.scrollable;
            el.removeAttribute('tabindex');
            el.removeAttribute('role');
            el.removeAttribute('aria-label');
          }
        }
      };
      addEventListener('load', markScrollable);
      addEventListener('resize', markScrollable);
      new MutationObserver(() => requestAnimationFrame(markScrollable)).observe(document.body, {
        subtree: true,
        childList: true,
      });
    </script>
    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        addEventListener('load', () =>
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }),
        );
      }
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: var(--space-2);
    top: -100px;
    z-index: 100;
    background: var(--color-ink);
    color: var(--color-bg);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
  }
  .skip:focus {
    top: var(--space-2);
  }
</style>
