---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import 'katex/dist/katex.min.css';
import '../styles/base.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { t } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** Hide the site header (home page draws its own). */
  bare?: boolean;
  /** Show the reading-progress ruler with section ticks. */
  ruler?: boolean;
  current?: 'map' | 'notations' | 'glossary';
}

const {
  title,
  description = t('site.description'),
  bare = false,
  ruler = false,
  current,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === t('site.title') ? title : `${title} | ${t('site.title')}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="theme-color" content="#F6F7F9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B111E" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {t('a11y.skip')}
    </a>
    {!bare && <SiteHeader ruler={ruler} {...(current ? { current } : {})} />}
    <slot />
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: var(--space-2);
    top: -100px;
    z-index: 100;
    background: var(--color-ink);
    color: var(--color-bg);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-sans);
  }
  .skip:focus {
    top: var(--space-2);
  }
</style>
