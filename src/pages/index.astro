---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveFieldHero from '../components/viz/WaveFieldHero.svelte';
import { ICONS } from '../lib/icons';
import { CURRICULUM } from '../content/curriculum';
import { t } from '../i18n';

const base = import.meta.env.BASE_URL;
const written = CURRICULUM.filter((n) => n.href);
---

<BaseLayout title={t('site.title')} bare>
  <main id="main">
    <section class="hero" aria-label="Champ d'onde interactif">
      <WaveFieldHero
        client:load
        alt="Champ de pression simulé en temps réel : des ondes circulaires se propagent, se réfléchissent sur les bords et interfèrent. Cliquez, touchez ou appuyez sur Entrée pour émettre une impulsion."
      />
      <a class="wordmark" href={base}>
        <Fragment set:html={ICONS.mark} />
        {t('site.title')}
      </a>
      <div class="panel">
        <h1>Faites des ondes.</h1>
        <p>
          Chaque clic émet une impulsion de pression. Elle se propage, se réfléchit sur les bords et
          interfère avec les autres&nbsp;: vous regardez une solution de l'équation des ondes,
          calculée en direct.
        </p>
        <div class="actions">
          <a class="btn" href={`${base}chapitres/01a-equation-des-ondes/`} data-resume>
            Commencer par l'équation des ondes
          </a>
          <a class="btn ghost" href={`${base}carte/`}>
            Carte du cours
          </a>
        </div>
      </div>
      <div class="hud" aria-hidden="true">
        <div class="name">
          <span>
            pression <i>p</i>
          </span>
          <span>unité arbitraire</span>
        </div>
        <div class="ramp"></div>
        <div class="ticks num">
          <span>−</span>
          <span>0</span>
          <span>+</span>
        </div>
        <p>Parois rigides. Schéma aux différences finies, nombre de Courant 0,5.</p>
      </div>
    </section>

    <section class="about">
      <div class="col">
        <h2>Un cours d'acoustique qu'on manipule</h2>
        <p>
          Niveau master et au-delà. Pour chaque notion, un schéma qui isole le mécanisme, des cas
          réels avec leurs ordres de grandeur, et le son quand il éclaire quelque chose. Les
          équations sont vivantes&nbsp;: chaque terme se désactive dans la simulation pour montrer à
          quoi il sert.
        </p>
        <h3>Déjà disponible</h3>
        <ul class="avail">
          {written.map((n) => (
            <li>
              <a href={`${base}${n.href}`}>
                <span class="n num">{n.num}</span>
                <span>
                  <b>{n.title}</b>
                  <span class="s">{n.summary}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="small">
          Contenu sous licence CC BY-SA 4.0, code sous licence MIT. Sans traceur ni cookie.{' '}
          <a href="https://github.com/thib1tree/cours-acoustique">Code source et contributions</a>.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { byId } from '../content/curriculum';
  import { lastVisited } from '../lib/progress/progress';
  const id = lastVisited();
  const node = id ? byId(id) : undefined;
  const a = document.querySelector<HTMLAnchorElement>('[data-resume]');
  if (node?.href && a) {
    a.href = `${import.meta.env.BASE_URL}${node.href}`;
    a.textContent = `Reprendre : ${node.title}`;
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    background: var(--color-bg);
  }
  .wordmark {
    position: absolute;
    top: var(--space-3);
    left: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch);
    padding: 0 var(--space-2);
    background: var(--color-bg);
    font-family: var(--font-sans);
    font-weight: 700;
    text-decoration: none;
  }
  .panel {
    position: absolute;
    left: var(--space-7);
    bottom: var(--space-7);
    max-width: 600px;
    padding: var(--space-6);
    background: var(--color-bg);
    border-top: 2px solid var(--color-ink);
  }
  h1 {
    font-size: 3.25rem;
  }
  .panel p {
    font-size: 1.2rem;
    margin: var(--space-4) 0 var(--space-5);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0 var(--space-5);
    border-radius: var(--radius);
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-weight: 650;
    font-size: var(--text-ui);
    text-decoration: none;
  }
  .btn.ghost {
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .hud {
    position: absolute;
    right: var(--space-7);
    bottom: var(--space-7);
    width: 260px;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    display: grid;
    gap: 4px;
    pointer-events: none;
  }
  .hud .name,
  .hud .ticks {
    display: flex;
    justify-content: space-between;
  }
  .hud .ticks,
  .hud p {
    color: var(--color-ink-muted);
  }
  .hud .ramp {
    height: 10px;
    background: var(--gradient-pressure);
  }
  .hud p {
    margin: 4px 0 0;
  }
  .about {
    border-top: 1px solid var(--color-rule);
    padding: var(--space-8) var(--space-5) var(--space-9);
  }
  .col {
    max-width: var(--measure);
    margin: 0 auto;
  }
  .about h2 {
    margin-top: 0;
  }
  .avail {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
  }
  .avail a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-rule);
    text-decoration: none;
  }
  .avail li:last-child a {
    border-bottom: 1px solid var(--color-rule);
  }
  .avail .n {
    color: var(--color-ink-muted);
  }
  .avail b {
    display: block;
    font-family: var(--font-sans);
    font-weight: 650;
  }
  .avail .s {
    color: var(--color-ink-muted);
    font-size: 1rem;
  }
  .small {
    font-size: 0.95rem;
    color: var(--color-ink-muted);
  }
  @media (max-width: 760px) {
    .wordmark {
      left: var(--gutter);
    }
    .panel {
      left: var(--gutter);
      right: var(--gutter);
      bottom: var(--gutter);
      padding: var(--space-4) var(--space-4) var(--space-5);
    }
    h1 {
      font-size: 2.25rem;
    }
    .panel p {
      font-size: 1.0625rem;
      margin: var(--space-3) 0 var(--space-4);
    }
    .hud {
      display: none;
    }
    .about {
      padding: var(--space-7) var(--gutter);
    }
  }
</style>
