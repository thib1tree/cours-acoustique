{
  "name": "cours-acoustique",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cours d'acoustique interactif open source, niveau master et au-delà.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check . && astro check",
    "format": "prettier --write .",
    "gen:tokens": "tsx scripts/gen-tokens.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/svelte": "^9.1.6",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "astro": "^7.4.12",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/literata": "^5.3.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@vite-pwa/astro": "^2.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
